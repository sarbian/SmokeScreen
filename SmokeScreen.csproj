<Project Sdk="Microsoft.NET.Sdk">

  <!--
    KSP 1.12 mod: a .NET Framework 4.8 class library built with the .NET SDK (no Visual Studio needed).
    The KSP assemblies come from the install named by KSPDIR (an environment variable, or -p:KSPDIR=<path>);
    on CI it is the KSPModdingLibs archive, which has the same KSP_x64_Data/Managed layout.
    With KSPDIR set, a build also copies the DLL and its pdb into GameData/SmokeScreen there.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SmokeScreen</AssemblyName>
    <RootNamespace>SmokeScreen</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <KspManaged>$(KSPDIR)/KSP_x64_Data/Managed</KspManaged>
  </PropertyGroup>

  <!-- Profiler.BeginSample and EndSample compile only with ENABLE_PROFILER -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);ENABLE_PROFILER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- the .NET Framework reference assemblies, so the build needs no targeting pack and works on Linux -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- the Unity project of the particle models and the NuGet folder of the old project are not part of the mod -->
    <Compile Remove="SmokeScreen-Unity/**;packages/**" />
    <!-- the config, icon and version template ship in the package, they are not compiled -->
    <None Include="GameData/**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KspManaged)/Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(KspManaged)/UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(KspManaged)/UnityEngine.AudioModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KspManaged)/UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(KspManaged)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(KspManaged)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(KspManaged)/UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(KspManaged)/UnityEngine.PhysicsModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.SharedInternalsModule">
      <HintPath>$(KspManaged)/UnityEngine.SharedInternalsModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(KspManaged)/UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyToKsp" AfterTargets="Build" Condition="'$(KSPDIR)' != ''">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(KSPDIR)/GameData/SmokeScreen" ContinueOnError="true" />
  </Target>

</Project>
